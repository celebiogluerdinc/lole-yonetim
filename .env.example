# Supabase projenizin URL'i ve anahtarları (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SADECE sunucu tarafında kullanılır — asla istemciye sızdırmayın
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Web Push (VAPID) — anlık bildirimler için
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# pg_cron'un /api/push ucunu çağırırken kullandığı gizli anahtar
CRON_SECRET=

# Faz 3 (Lole Asistan) için — şimdilik boş bırakılabilir
ANTHROPIC_API_KEY=

# Seed script'in oluşturacağı kullanıcıların ortak geçici parolası
SEED_PASSWORD=Lole!2026
